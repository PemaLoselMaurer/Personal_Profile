---
// A page section on the 12-column grid: a 1px rule, a numbered serif title
// in the left columns (it stays in view while the section scrolls), and the
// content beside it. On its own colour: solid
// without the 3D world, a see-through veil over it with (styles/motion.css).
//
//   tone  "day" (ink on cream) or "night" (cream on Prussian).
import { sectionLabel } from "../data/content";

interface Props {
  id: string;
  tone?: "day" | "night";
  class?: string;
}
const { id, tone = "day", class: className } = Astro.props;
const { num, title } = sectionLabel(id);
---

<section id={id} class:list={["section", `section--${id}`, className]} data-tone={tone} aria-labelledby={`${id}-label`}>
  <div class="wrap grid">
    <h2 class="label" id={`${id}-label`} data-reveal="fade">
      <span class="label__num">{num}</span>
      <span class="label__title">{title}</span>
    </h2>
    <slot />
  </div>
</section>
