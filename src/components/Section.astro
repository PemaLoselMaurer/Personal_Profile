---
// A page section on the 12-column grid: a 1px rule, a small numbered label
// in the left columns, and the content beside it.
//
//   tone  "day" (ink on cream) or "night" (cream on Prussian). Without the 3D
//         world this is the section's solid background; with it, it picks
//         the colour of the veil drawn over the world while you read.
//   shot  where the camera of the 3D world sits while this section is read
//         (names in src/motion/world.ts).
import { sectionLabel } from "../data/content";

interface Props {
  id: string;
  tone?: "day" | "night";
  /** Omit when children carry their own shots (the project cards). */
  shot?: string;
  /** Veil strength over the world while read (0–1). Lower shows more of the print. */
  veil?: number;
  class?: string;
}
const { id, tone = "day", shot, veil, class: className } = Astro.props;
---

<section
  id={id}
  class:list={["section", `section--${id}`, className]}
  data-tone={tone}
  data-shot={shot}
  data-veil={veil}
  aria-labelledby={`${id}-label`}
>
  <div class="wrap grid">
    <h2 class="label" id={`${id}-label`} data-reveal="fade">{sectionLabel(id)}</h2>
    <slot />
  </div>
</section>
